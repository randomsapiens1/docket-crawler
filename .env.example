# ── Database (Neon free tier) ─────────────────────────────────────────────────
# Get from: https://neon.tech → New Project → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── AI (OpenRouter free tier) ─────────────────────────────────────────────────
# Get from: https://openrouter.ai → API Keys
# Uses deepseek/deepseek-r1:free by default (free with rate limits)
OPENROUTER_API_KEY=sk-or-...

# Optional: Use DeepSeek direct API instead (~$0.40/month at MVP scale)
# Get from: https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-...
# AI_MODEL=deepseek-chat

# ── Crawler settings ──────────────────────────────────────────────────────────
MAX_PAGES_PER_SITE=10
BATCH_INDEX=0
BATCH_TOTAL=1
